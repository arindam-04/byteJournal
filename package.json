{
  "name": "bytejournal-fullstack",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "check:server": "node --check server/src/index.js && node --check server/src/db.js",
    "start": "npm run start -w server",
    "check": "npm run check -w server && npm test",
    "db:migrate": "npm run migrate -w server",
    "db:check": "npm run db:check -w server",
    "db:backup": "npm run backup -w server --",
    "db:restore": "npm run restore -w server --",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
