# PostgreSQL connection (create this database and user on your host)
DATABASE_URL=postgresql://bytejournal:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/bytejournal
PGSSL=false
PG_POOL_MAX=10

# Application
HOST=127.0.0.1
PORT=4000
# Exact browser origin(s), comma-separated when frontend and API are separate.
CLIENT_ORIGIN=http://localhost:5173
# Canonical public website URL.
PUBLIC_SITE_URL=http://localhost:5173
# Keep false for local HTTP; set true when using HTTPS in production.
COOKIE_SECURE=false

# First-run Super Admin (created only when this email does not already exist)
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_OF_AT_LEAST_12_CHARACTERS

# SMTP for invitation, password-reset, and test emails
# Use port 587 with SMTP_SECURE=false (STARTTLS), or port 465 with SMTP_SECURE=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=ByteJournal <no-reply@example.com>
